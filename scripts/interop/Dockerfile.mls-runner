FROM ubuntu@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --yes \
    ca-certificates \
    golang \
    protobuf-compiler \
  && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home runner
USER runner
WORKDIR /home/runner

ENV GOPATH=/home/runner/go
ENV PATH=/home/runner/go/bin:${PATH}

# These generator versions produce bindings compatible with the harness's
# google.golang.org/grpc v1.56.3 dependency. The upstream Dockerfile uses
# `latest`, which is not reproducible and no longer compiles this revision.
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.31.0
RUN go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0

COPY --chown=runner . /home/runner/mls-implementations
WORKDIR /home/runner/mls-implementations/interop

RUN protoc \
  --go_out=proto \
  --go_opt=paths=source_relative \
  --go-grpc_out=proto \
  --go-grpc_opt=paths=source_relative \
  --proto_path=proto \
  mls_client.proto

WORKDIR /home/runner/mls-implementations/interop/test-runner
RUN go mod tidy && go build -trimpath -o /home/runner/mls-test-runner .

ENTRYPOINT ["/home/runner/mls-test-runner"]
