{
  "name": "@absolutejs/e2ee-providers",
  "private": true,
  "type": "module",
  "workspaces": [
    "mls",
    "webcrypto"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "certify:browser": "bun run scripts/certify-browser.ts",
    "certify:adapter-interop": "bun run scripts/certify-mls-adapter-interop.ts",
    "certify:interop": "bun run scripts/certify-mls-interop.ts",
    "check:package": "bun run format:check && bun run typecheck && bun run test && bun run build && bun run --filter './*' verify-package",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{ts,json,md}\"",
    "test": "bun test scripts && bun run --filter './*' test",
    "typecheck": "bun run --filter './*' typecheck"
  },
  "devDependencies": {
    "@absolutejs/e2ee": "0.7.0",
    "@absolutejs/manifest": "^0.9.0",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "^1.3.14",
    "playwright": "1.60.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  }
}
